@PACKAGE_INIT@
set_and_check(CEREAL_INCLUDE_DIR "@PACKAGE_CEREAL_INSTALL_INC_DIR@")

if(NOT TARGET @PROJECT_NAME@)
  include("${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@Targets.cmake")
endif()

set(CEREAL_INCLUDE_DIRS ${CEREAL_INCLUDE_DIR} )
set(CEREAL_LIBRARIES cereal)

check_required_components(@PROJECT_NAME@)

include(CMakeFindDependencyMacro)
find_dependency(RapidJSON CONFIG)

# RapidJSON is nuts
if (NOT "${RAPIDJSON_CMAKE_DIR}" STREQUAL "")
  set(INCLUDE_DIR ${RAPIDJSON_CMAKE_DIR}/../../../include)
else()
  set(INCLUDE_DIR ${RapidJSON_CMAKE_DIR}/../../../include)
endif()

target_include_directories(cereal::cereal INTERFACE ${INCLUDE_DIR})
find_package(RapidXML MODULE REQUIRED)
